{{ 'component-button.css' | asset_url | stylesheet_tag }}
{%- if block.settings.label != blank -%}
  <a class="btn btn--{{ block.settings.style }}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
{%- endif -%}
{% schema %}
{
  "name": "t:blocks.button.name",
  "settings": [
    {"type": "text", "id": "label", "label": "t:blocks.button.settings.label.label", "default": "Shop now"},
    {"type": "url", "id": "link", "label": "t:sections.all.link"},
    {"type": "select", "id": "style", "label": "t:sections.all.style", "options": [{"value": "primary", "label": "t:blocks.button.settings.style.options__1.label"}, {"value": "secondary", "label": "t:blocks.button.settings.style.options__2.label"}, {"value": "ghost", "label": "t:blocks.button.settings.style.options__3.label"}, {"value": "light", "label": "t:blocks.button.settings.style.options__4.label"}, {"value": "outline-light", "label": "t:blocks.button.settings.style.options__5.label"}], "default": "primary"}
  ]
}
{% endschema %}
