<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="canonical" href="{{ canonical_url }}">
  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {%- render 'css-vars' -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'component-button.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main id="main" class="container container--narrow section stack" style="text-align:center">
    <h1>{{ shop.name }}</h1>
    {{ content_for_layout }}
  </main>
</body>
</html>
