<script src="{{ 'before-after.js' | asset_url }}" defer></script>

<section class="section" data-section="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__head">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="text-muted">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <before-after-slider class="before-after" style="--position: {{ section.settings.initial_position | default: 50 }}%;">
      <div class="before-after__container" style="position: relative; overflow: hidden; border-radius: var(--radius-card); aspect-ratio: {{ section.settings.aspect_ratio | default: '16/9' }};">
        <div class="before-after__image before-after__image--after" style="position: absolute; inset: 0; width: 100%; height: 100%;">
          {%- if section.settings.image_after != blank -%}
            {{ section.settings.image_after | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 48em) 80vw, 100vw', style: 'width: 100%; height: 100%; object-fit: cover;' }}
          {%- else -%}
            {% render 'placeholder', kind: 'lifestyle', index: 2, sizes: '100vw' %}
          {%- endif -%}
          <span class="badge" style="position: absolute; bottom: var(--space-4); right: var(--space-4); z-index: 2;">{{ section.settings.label_after | default: 'After' }}</span>
        </div>

        <div class="before-after__overlay" style="position: absolute; inset: 0; width: 100%; height: 100%; clip-path: polygon(0 0, var(--position) 0, var(--position) 100%, 0 100%);">
          {%- if section.settings.image_before != blank -%}
            {{ section.settings.image_before | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 48em) 80vw, 100vw', style: 'width: 100%; height: 100%; object-fit: cover;' }}
          {%- else -%}
            {% render 'placeholder', kind: 'lifestyle', index: 1, sizes: '100vw' %}
          {%- endif -%}
          <span class="badge" style="position: absolute; bottom: var(--space-4); left: var(--space-4); z-index: 2;">{{ section.settings.label_before | default: 'Before' }}</span>
        </div>

        <div class="before-after__divider" style="position: absolute; top: 0; bottom: 0; left: var(--position); width: 2px; background: #fff; pointer-events: none; z-index: 3;">
          <div class="before-after__handle" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 2.5rem; height: 2.5rem; border-radius: var(--radius-full); background: #fff; color: #1c1b19; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-lift);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg>
          </div>
        </div>

        <input type="range" min="0" max="100" value="{{ section.settings.initial_position | default: 50 }}" aria-label="Before and after comparison slider" style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; z-index: 4; margin: 0;">
      </div>
    </before-after-slider>
  </div>
</section>

{% schema %}
{
  "name": "Before / After Slider",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Craft & Transformation"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Slide to compare before and after"},
    {"type": "image_picker", "id": "image_before", "label": "Before Image"},
    {"type": "text", "id": "label_before", "label": "Before Label", "default": "Raw"},
    {"type": "image_picker", "id": "image_after", "label": "After Image"},
    {"type": "text", "id": "label_after", "label": "After Label", "default": "Finished"},
    {"type": "select", "id": "aspect_ratio", "label": "Aspect Ratio", "options": [{"value": "16/9", "label": "16:9"}, {"value": "4/3", "label": "4:3"}, {"value": "1/1", "label": "Square"}], "default": "16/9"},
    {"type": "range", "id": "initial_position", "label": "Initial Divider Position", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 50}
  ],
  "presets": [
    {"name": "Before / After Slider"}
  ]
}
{% endschema %}
