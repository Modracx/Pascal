{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign blog = section.settings.blog -%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__header">
      <h2>{{ section.settings.heading | default: blog.title }}</h2>
      {%- if blog != blank -%}<a href="{{ blog.url }}">{{ 'blog.view_all' | t }}</a>{%- endif -%}
    </div>
    <div class="article-list">
      {%- for article in blog.articles limit: section.settings.limit -%}
        <a class="article-card" href="{{ article.url }}">
          {%- if article.image -%}<div class="article-card__media">{%- render 'media', image: article.image, sizes: '(min-width: 48em) 33vw, 100vw', widths: '400, 600, 800, 1000' -%}</div>{%- endif -%}
          <p class="text-sm text-muted">{{ article.published_at | date: '%b %d, %Y' }}</p>
          <h2 style="font-size: var(--text-lg)">{{ article.title | escape }}</h2>
          <p class="text-sm text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
        </a>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="article-card"><div class="article-card__media">{% render 'placeholder', kind: 'article', index: i, sizes: '(min-width: 48em) 33vw, 100vw' %}</div><h2 style="font-size: var(--text-lg)">Article title</h2><p class="text-sm text-muted">A short excerpt of the article appears here.</p></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "settings": [
    {"type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "From the journal"},
    {"type": "blog", "id": "blog", "label": "t:sections.blog_posts.settings.blog.label"},
    {"type": "range", "id": "limit", "label": "t:sections.blog_posts.settings.limit.label", "min": 2, "max": 6, "step": 1, "default": 3}
  ],
  "presets": [
    {"name": "t:sections.blog_posts.presets.name"}
  ]
}
{% endschema %}
