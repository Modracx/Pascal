{{ 'section-premium.css' | asset_url | stylesheet_tag }}
<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if section.settings.heading != blank -%}<div class="section__header"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="spotlight">
      {%- for block in section.blocks limit: 3 -%}
        {%- assign c = block.settings.collection -%}
        {%- if forloop.index == 2 -%}<div class="spotlight__stack">{%- endif -%}
        <a class="spotlight__tile" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img != blank -%}{%- render 'media', image: img, sizes: '(min-width: 48em) 50vw, 100vw', widths: '500, 800, 1200, 1600' -%}{%- else -%}{% render 'placeholder', kind: 'tile', index: forloop.index, sizes: '(min-width: 48em) 50vw, 100vw' %}{%- endif -%}
          <div class="spotlight__body">
            <h3>{{ block.settings.title | default: c.title | default: 'Collection' }}</h3>
            <span>{{ block.settings.caption | default: 'Shop now' }}</span>
          </div>
        </a>
        {%- if forloop.last and forloop.index > 1 -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.category_spotlight.name",
  "settings": [
    {"type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Shop by room"}
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:sections.category_spotlight.blocks.tile.name",
      "limit": 3,
      "settings": [
        {"type": "collection", "id": "collection", "label": "t:sections.all.collection"},
        {"type": "image_picker", "id": "image", "label": "t:sections.category_spotlight.blocks.tile.settings.image.label"},
        {"type": "text", "id": "title", "label": "t:sections.category_spotlight.blocks.tile.settings.title.label"},
        {"type": "text", "id": "caption", "label": "t:sections.category_spotlight.blocks.tile.settings.caption.label", "default": "Shop now"}
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.category_spotlight.presets.name",
      "blocks": [
        {"type": "tile"},
        {"type": "tile"},
        {"type": "tile"}
      ]
    }
  ]
}
{% endschema %}
