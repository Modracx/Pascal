{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundle-builder.js' | asset_url }}" defer></script>

<section class="section" data-section="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__head">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="text-muted">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <bundle-builder class="bundle-builder">
      <div class="split split--equal" style="gap: var(--space-8); align-items: center;">
        <div class="bundle-builder__media" style="position: relative; border-radius: var(--radius-card); overflow: hidden; background: var(--color-plate);">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 48em) 50vw, 100vw', class: 'bundle-builder__img' }}
          {%- else -%}
            {% render 'placeholder', kind: 'lifestyle', index: 1, sizes: '(min-width: 48em) 50vw, 100vw' %}
          {%- endif -%}
        </div>

        <div class="bundle-builder__content stack" style="gap: var(--space-6);">
          <div class="bundle-builder__list stack" style="gap: var(--space-4);">
            {%- for block in section.blocks -%}
              {%- assign product = block.settings.product -%}
              {%- if product != blank -%}
                {%- assign variant = product.selected_or_first_available_variant -%}
                <div class="bundle-item" data-variant-id="{{ variant.id }}" data-price="{{ variant.price }}" {{ block.shopify_attributes }} style="display: grid; grid-template-columns: auto 4rem 1fr auto; gap: var(--space-3); align-items: center; padding: var(--space-3); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-md);">
                  <label class="bundle-item__check">
                    <input type="checkbox" checked value="{{ variant.id }}" aria-label="Include {{ product.title }}">
                  </label>
                  <div class="bundle-item__img" style="aspect-ratio: 1; border-radius: var(--radius-sm); overflow: hidden; background: var(--color-plate);">
                    {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 60, height: 60 }}
                  </div>
                  <div class="bundle-item__info">
                    <h4 class="text-sm" style="font-weight: 500; margin: 0;"><a href="{{ product.url }}">{{ product.title }}</a></h4>
                    {%- if product.variants.size > 1 -%}
                      <select name="id" class="select select--sm" style="margin-top: var(--space-1); font-size: var(--text-xs); padding-block: 2px;">
                        {%- for v in product.variants -%}
                          <option value="{{ v.id }}" data-price="{{ v.price }}"{% if v == variant %} selected{% endif %}>{{ v.title }} - {{ v.price | money }}</option>
                        {%- endfor -%}
                      </select>
                    {%- else -%}
                      <span class="text-xs text-muted">{{ variant.price | money }}</span>
                    {%- endif -%}
                  </div>
                  <div class="bundle-item__price text-sm" style="font-weight: 500;">
                    {{ variant.price | money }}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="bundle-builder__actions" style="margin-top: var(--space-4);">
            <button type="button" class="btn btn--full" data-bundle-submit>
              <span>Add Look to Cart (<span data-bundle-count>0</span> items)</span>
            </button>
          </div>
        </div>
      </div>
    </bundle-builder>
  </div>
</section>

{% schema %}
{
  "name": "Complete the look",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Complete the Look"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Curated pieces styled together"},
    {"type": "image_picker", "id": "image", "label": "Lookbook Image"}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [
        {"type": "product", "id": "product", "label": "Product"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Complete the look",
      "blocks": [
        {"type": "product"},
        {"type": "product"}
      ]
    }
  ]
}
{% endschema %}
