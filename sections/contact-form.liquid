{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__header"><h2>{{ section.settings.heading }}</h2></div>
    {%- assign form_id = 'contact-' | append: section.id -%}
    {%- form 'contact', id: form_id, class: 'contact' -%}
      {%- assign success = 'contact.success' | t -%}
      {%- render 'form-errors', form: form, success: success -%}
      <div class="contact__row">
        {%- assign label = 'contact.name' | t -%}
        {%- assign field_id = 'contact-name-' | append: section.id -%}
        {%- render 'field', id: field_id, name: 'contact[name]', label: label, value: form.name, autocomplete: 'name', required: true, errors: form.errors, field: 'name' -%}
        {%- assign label = 'contact.email' | t -%}
        {%- assign field_id = 'contact-email-' | append: section.id -%}
        {%- render 'field', id: field_id, name: 'contact[email]', label: label, type: 'email', value: form.email, autocomplete: 'email', required: true, errors: form.errors, field: 'email' -%}
      </div>
      {%- assign label = 'contact.message' | t -%}
      {%- assign field_id = 'contact-body-' | append: section.id -%}
      {%- render 'field', id: field_id, name: 'contact[body]', label: label, type: 'textarea', rows: 6, value: form.body, required: true, errors: form.errors, field: 'body' -%}
      <div><button type="submit" class="btn">{{ 'contact.send' | t }}</button></div>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    {"type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Get in touch"}
  ],
  "presets": [
    {"name": "t:sections.contact_form.presets.name"}
  ]
}
{% endschema %}
