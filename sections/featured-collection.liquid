{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{%- if section.settings.layout == 'carousel' -%}{{ 'component-carousel.css' | asset_url | stylesheet_tag }}<script src="{{ 'carousel.js' | asset_url }}" defer></script>{%- endif -%}
{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign heading = s.heading | default: collection.title
-%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if s.layout == 'carousel' -%}<scroll-carousel class="carousel carousel--bleed">{%- endif -%}
    <div class="section__header">
      <div><h2>{{ heading }}</h2>{%- if s.subheading != blank -%}<p class="section__sub">{{ s.subheading }}</p>{%- endif -%}</div>
      <div style="display:flex;gap:var(--space-6);align-items:center">
        {%- if s.show_view_all and collection != blank -%}<a href="{{ collection.url }}" class="link">{{ 'collections.view_all' | t: count: collection.all_products_count }}</a>{%- endif -%}
        {%- if s.layout == 'carousel' -%}<div class="carousel__nav"><button type="button" class="ctrl" data-prev aria-label="{{ 'general.previous' | t }}"><span style="display:inline-flex;transform:rotate(180deg)">{% render 'icon', name: 'arrow', size: 16 %}</span></button><button type="button" class="ctrl" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow', size: 16 %}</button></div>{%- endif -%}
      </div>
    </div>
    <div class="{% if s.layout == 'carousel' %}carousel__track{% else %}grid{% endif %}" style="--cols-desktop: {{ s.columns }}; --per-view: {{ s.columns }}"{% if s.layout == 'carousel' %} data-track{% endif %}>
      {%- for product in collection.products limit: s.limit -%}
        {%- render 'product-card', product: product, show_vendor: settings.card_show_vendor, show_hover_image: settings.card_hover_image, quick_add: settings.card_quick_add, quick_view: settings.card_quick_view, show_swatches: settings.card_swatches -%}
      {%- else -%}
        {%- for i in (1..s.limit) -%}
          <article class="product-card">
            <div class="product-card__media">{% render 'placeholder', kind: 'product', index: i, sizes: '(min-width: 64em) 25vw, (min-width: 48em) 33vw, 50vw' %}</div>
            <div class="product-card__body"><div class="product-card__row"><h3 class="product-card__title">Product title</h3><span class="price"><span class="price__current">$29.00</span></span></div></div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    {%- if s.layout == 'carousel' -%}</scroll-carousel>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {"type": "text", "id": "heading", "label": "t:sections.all.heading", "info": "t:sections.featured_collection.settings.heading.info"},
    {"type": "text", "id": "subheading", "label": "t:sections.featured_collection.settings.subheading.label"},
    {"type": "select", "id": "layout", "label": "t:sections.all.layout", "options": [{"value": "grid", "label": "t:sections.featured_collection.settings.layout.options__1.label"}, {"value": "carousel", "label": "t:sections.featured_collection.settings.layout.options__2.label"}], "default": "grid"},
    {"type": "collection", "id": "collection", "label": "t:sections.all.collection"},
    {"type": "range", "id": "limit", "label": "t:sections.all.products", "min": 2, "max": 12, "step": 1, "default": 8},
    {"type": "range", "id": "columns", "label": "t:sections.featured_collection.settings.columns.label", "min": 2, "max": 5, "step": 1, "default": 4},
    {"type": "checkbox", "id": "show_view_all", "label": "t:sections.featured_collection.settings.show_view_all.label", "default": true}
  ],
  "presets": [
    {"name": "t:sections.featured_collection.presets.name"}
  ]
}
{% endschema %}
