{{ 'component-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign menu_blocks = section.blocks | where: 'type', 'menu' -%}
<footer class="footer" style="--footer-cols: {{ menu_blocks.size | at_least: 1 }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="footer__grid">
      <div class="footer__newsletter">
        <p class="footer__heading">{{ section.settings.newsletter_heading }}</p>
        {%- if section.settings.newsletter_text != blank -%}<div class="rte text-muted">{{ section.settings.newsletter_text }}</div>{%- endif -%}
        {%- form 'customer', id: 'footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- assign success = 'general.newsletter.success' | t -%}
          {%- render 'form-errors', form: form, success: success -%}
          {%- unless form.posted_successfully? -%}
            {%- assign label = 'general.newsletter.label' | t -%}
            {%- assign placeholder = 'general.newsletter.placeholder' | t -%}
            <div class="footer__pill">
              {%- render 'field', id: 'footer-email', name: 'contact[email]', label: label, label_hidden: true, type: 'email', placeholder: placeholder, autocomplete: 'email', required: true, errors: form.errors, field: 'email' -%}
              <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
            </div>
          {%- endunless -%}
        {%- endform -%}
        <div style="margin-top: var(--space-5)">{%- render 'social-icons' -%}</div>
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <p class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}</p>
            <ul class="footer__links" role="list">
              {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'text' -%}
          <div {{ block.shopify_attributes }}>
            <p class="footer__heading">{{ block.settings.heading }}</p>
            <div class="rte text-muted">{{ block.settings.text }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="footer__wordmark" aria-hidden="true">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', width: settings.logo.width, height: settings.logo.height }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </div>
    <div class="footer__bottom">
      <div style="display:grid;gap:var(--space-3)">
        {%- render 'localization', id: 'footer' -%}
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}</p>
      </div>
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {"type": "text", "id": "newsletter_heading", "label": "t:sections.footer.settings.newsletter_heading.label", "default": "Stay in the loop"},
    {"type": "richtext", "id": "newsletter_text", "label": "t:sections.footer.settings.newsletter_text.label", "default": "<p>New arrivals, offers and stories. No spam.</p>"},
    {"type": "checkbox", "id": "show_payment_icons", "label": "t:sections.footer.settings.show_payment_icons.label", "default": true},
    {"type": "checkbox", "id": "show_follow_on_shop", "label": "t:sections.footer.settings.show_follow_on_shop.label", "info": "t:sections.footer.settings.show_follow_on_shop.info", "default": true}
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {"type": "text", "id": "heading", "label": "t:sections.all.heading"},
        {"type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.menu.settings.menu.label", "default": "footer"}
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {"type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "About"},
        {"type": "richtext", "id": "text", "label": "t:sections.all.text", "default": "<p>Tell customers who you are.</p>"}
      ]
    }
  ],
  "default": {
    "blocks": [
      {"type": "menu"}
    ]
  }
}
{% endschema %}
