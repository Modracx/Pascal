{{ 'section-extras.css' | asset_url | stylesheet_tag }}
<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if section.settings.heading != blank -%}<p class="text-sm text-muted" style="text-align:center; margin-bottom: var(--space-6)">{{ section.settings.heading }}</p>{%- endif -%}
    <div class="logos" style="--columns: {{ section.blocks.size | at_least: 2 | at_most: 6 }}">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.image.alt | escape }}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- else -%}
            <p class="text-muted" style="text-align:center">Logo</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.logo_list.name",
  "settings": [
    {"type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "As seen in"}
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_list.blocks.logo.name",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "t:sections.all.image"},
        {"type": "url", "id": "link", "label": "t:sections.all.link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_list.presets.name",
      "blocks": [
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"}
      ]
    }
  ]
}
{% endschema %}
