{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
<section class="section"><div class="container">
  <div class="section__header"><h1>{{ 'customer.order.title' | t: name: order.name }}</h1><a href="{{ routes.account_url }}">{{ 'customer.order.back' | t }}</a></div>
  <div class="account account--split">
    {%- render 'account-nav' -%}
    <div class="stack" style="--stack-gap: var(--space-8)">
      <p class="text-muted">{{ 'customer.order.date' | t: date: order.created_at | date: '%B %d, %Y' }}{% if order.cancelled %} · {{ 'customer.order.cancelled' | t: date: order.cancelled_at | date: '%B %d, %Y' }}{% endif %}</p>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.sku' | t }}</th><th>{{ 'customer.order.price' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
        <tbody>
          {%- for item in order.line_items -%}
            <tr>
              <td>{% if item.url %}<a href="{{ item.url }}" style="text-decoration:underline">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
                {%- if item.fulfillment -%}<br><span class="text-muted">{{ 'customer.order.fulfilled' | t: date: item.fulfillment.created_at | date: '%b %d, %Y' }}{% if item.fulfillment.tracking_url %} · <a href="{{ item.fulfillment.tracking_url }}" style="text-decoration:underline">{{ 'customer.order.track' | t }}</a>{% endif %}</span>{%- endif -%}
              </td>
              <td>{{ item.sku }}</td>
              <td>{{ item.final_price | money }}</td>
              <td>{{ item.quantity }}</td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="4">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for d in order.cart_level_discount_applications -%}<tr><td colspan="4">{{ d.title }}</td><td>-{{ d.total_allocated_amount | money }}</td></tr>{%- endfor -%}
          {%- for s in order.shipping_methods -%}<tr><td colspan="4">{{ 'customer.order.shipping' | t }} ({{ s.title }})</td><td>{{ s.price | money }}</td></tr>{%- endfor -%}
          {%- for t in order.tax_lines -%}<tr><td colspan="4">{{ 'customer.order.tax' | t }} ({{ t.title }} {{ t.rate | times: 100 }}%)</td><td>{{ t.price | money }}</td></tr>{%- endfor -%}
          <tr><td colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_price | money_with_currency }}</strong></td></tr>
        </tfoot>
      </table></div>
      <div class="split">
        <div class="address"><h3>{{ 'customer.order.billing' | t }}</h3><p class="text-muted">{{ order.financial_status_label }}</p>{{ order.billing_address | format_address }}</div>
        <div class="address"><h3>{{ 'customer.order.shipping_address' | t }}</h3><p class="text-muted">{{ order.fulfillment_status_label }}</p>{{ order.shipping_address | format_address }}</div>
      </div>
    </div>
  </div>
</div></section>
{% schema %}
{
  "name": "t:sections.main_order.name",
  "settings": []
}
{% endschema %}
