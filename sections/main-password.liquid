<div class="stack">
  {%- if shop.password_message != blank -%}<p class="text-muted">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'stack' -%}
    {%- render 'form-errors', form: form -%}
    {%- assign label = 'general.password.label' | t -%}
    {%- render 'field', id: 'password', name: 'password', label: label, type: 'password', autocomplete: 'current-password', required: true, errors: form.errors, field: 'password' -%}
    <button type="submit" class="btn">{{ 'general.password.submit' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
