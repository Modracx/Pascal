{%- if predictive_search.performed -%}
{%- assign terms = predictive_search.terms | escape -%}
<div data-predictive-inner>
  {%- if predictive_search.resources.products.size > 0 -%}
    <div class="predictive__group">
      <p class="predictive__label">{{ 'general.search.products' | t }}</p>
      {%- for product in predictive_search.resources.products -%}
        <a class="predictive__item" href="{{ product.url }}">
          {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', width: 44, height: 44, alt: '' }}
          <span>
            {%- if settings.predictive_search_show_vendor -%}<span class="text-muted">{{ product.vendor }}</span><br>{%- endif -%}
            {{ product.title }}
            {%- if settings.predictive_search_show_price -%}<br><span class="text-muted">{{ product.price | money }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if predictive_search.resources.collections.size > 0 -%}
    <div class="predictive__group">
      <p class="predictive__label">{{ 'general.collections' | t }}</p>
      {%- for c in predictive_search.resources.collections -%}<a class="predictive__item" href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
    </div>
  {%- endif -%}
  {%- if predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
    <div class="predictive__group">
      <p class="predictive__label">{{ 'general.search.pages' | t }}</p>
      {%- for a in predictive_search.resources.articles -%}<a class="predictive__item" href="{{ a.url }}">{{ a.title }}</a>{%- endfor -%}
      {%- for pg in predictive_search.resources.pages -%}<a class="predictive__item" href="{{ pg.url }}">{{ pg.title }}</a>{%- endfor -%}
    </div>
  {%- endif -%}
  {%- if predictive_search.resources.products.size == 0 and predictive_search.resources.collections.size == 0 and predictive_search.resources.articles.size == 0 and predictive_search.resources.pages.size == 0 -%}
    <p class="predictive__label">{{ 'general.search.no_results_short' | t }}</p>
  {%- endif -%}
  <a class="predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}">{{ 'general.search.view_all' | t: terms: terms }}</a>
</div>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.predictive_search.name",
  "settings": []
}
{% endschema %}
