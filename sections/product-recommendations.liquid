{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if s.intent == 'complementary' and heading == blank
    assign heading = 'products.complementary' | t
  elsif heading == blank
    assign heading = 'products.recommendations' | t
  endif
-%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent={{ s.intent }}">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="section__header"><h2>{{ heading }}</h2></div>
        <div class="grid" style="--cols-desktop: {{ s.limit | at_most: 5 }}">
          {%- for product in recommendations.products -%}
            {%- render 'product-card', product: product, show_vendor: settings.card_show_vendor, show_hover_image: settings.card_hover_image, quick_add: settings.card_quick_add, quick_view: settings.card_quick_view, show_swatches: settings.card_swatches -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-recommendations>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "settings": [
    {"type": "text", "id": "heading", "label": "t:sections.all.heading", "info": "t:sections.product_recommendations.settings.heading.info"},
    {"type": "select", "id": "intent", "label": "t:sections.product_recommendations.settings.intent.label", "options": [{"value": "related", "label": "t:sections.product_recommendations.settings.intent.options__1.label"}, {"value": "complementary", "label": "t:sections.product_recommendations.settings.intent.options__2.label"}], "default": "related", "info": "t:sections.product_recommendations.settings.intent.info"},
    {"type": "range", "id": "limit", "label": "t:sections.all.products", "min": 2, "max": 10, "step": 1, "default": 4}
  ],
  "enabled_on": {"templates": ["product"]},
  "presets": [
    {"name": "t:sections.product_recommendations.presets.name"}
  ]
}
{% endschema %}
