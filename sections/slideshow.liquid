{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
<section class="section section--flush" {{ section.shopify_attributes }}>
  <div class="container slideshow" style="--slide-height: {{ section.settings.height }}vh">
    <div class="slideshow__track">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="slideshow__slide" id="slide-{{ section.id }}-{{ forloop.index }}" style="--slide-overlay: {{ b.overlay | divided_by: 100.0 }};{% if b.text_light %} --slide-color: #fff;{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            {%- assign priority = forloop.first -%}
            {%- render 'media', image: b.image, sizes: '100vw', priority: priority, widths: '800, 1200, 1600, 2000, 2400' -%}
            <div class="slideshow__overlay"></div>
          {%- else -%}
            {%- render 'placeholder', kind: 'wide', index: forloop.index, priority: forloop.first -%}
            <div class="slideshow__overlay"></div>
          {%- endif -%}
          <div class="slideshow__content">
            {%- if b.heading != blank -%}<h2>{{ b.heading }}</h2>{%- endif -%}
            {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
            {%- if b.button_label != blank -%}<a href="{{ b.link }}" class="btn">{{ b.button_label }}</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}<a href="#slide-{{ section.id }}-{{ forloop.index }}" aria-label="{{ 'general.slide' | t: index: forloop.index }}"></a>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.slideshow.name",
  "settings": [
    {"type": "range", "id": "height", "label": "t:sections.all.height", "min": 40, "max": 90, "step": 5, "unit": "vh", "default": 60}
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "t:sections.all.image"},
        {"type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Slide heading"},
        {"type": "text", "id": "text", "label": "t:sections.all.text"},
        {"type": "text", "id": "button_label", "label": "t:sections.all.button_label", "default": "Shop now"},
        {"type": "url", "id": "link", "label": "t:sections.all.link"},
        {"type": "range", "id": "overlay", "label": "t:sections.all.overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30},
        {"type": "checkbox", "id": "text_light", "label": "t:sections.slideshow.blocks.slide.settings.text_light.label", "default": true}
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets.name",
      "blocks": [
        {"type": "slide"},
        {"type": "slide"}
      ]
    }
  ]
}
{% endschema %}
