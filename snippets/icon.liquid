{%- comment -%} Inline SVG icons. Usage: {% render 'icon', name: 'cart', size: 20 %} {%- endcomment -%}
{%- liquid
  assign size = size | default: 20
  assign label = label | default: blank
-%}
<svg class="icon icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" {% if label != blank %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true" focusable="false"{% endif %}>
  {%- case name -%}
    {%- when 'cart' -%}<path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'chevron' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'return' -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>
    {%- when 'shield' -%}<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'star' -%}<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/>
    {%- when 'check' -%}<path d="m5 12 4 4L19 7"/>
    {%- when 'play' -%}<path d="M7 4v16l13-8z" fill="currentColor" stroke="none"/>
    {%- when 'share' -%}<path d="M18 5a2.5 2.5 0 1 1 0 .01M6 12a2.5 2.5 0 1 1 0 .01M18 19a2.5 2.5 0 1 1 0 .01M8.2 10.8l7.6-4.6M8.2 13.2l7.6 4.6"/>
