{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">{% render 'icon', name: 'arrow', size: 16 %}<span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span></a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>
      {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">{% render 'icon', name: 'arrow', size: 16 %}<span class="visually-hidden">{{ 'general.pagination.next' | t }}</span></a>{%- endif -%}
  </nav>
{%- endif -%}
